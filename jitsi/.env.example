# Jitsi configuration
JITSI_DOMAIN=meet.example.uz
CONFIG=~/.jitsi-meet-cfg

# JWT auth
JWT_APP_ID=meettrack
JWT_APP_SECRET=CHANGE_ME
JWT_ACCEPTED_ISSUERS=meettrack
JWT_ACCEPTED_AUDIENCES=jitsi

# JVB — публичный IP сервера igore-d02 (без NAT)
JVB_ADVERTISE_IPS=130.49.171.90

# Внутренние XMPP-пароли компонентов (генерировать: openssl rand -hex 16)
JICOFO_AUTH_PASSWORD=CHANGE_ME
JVB_AUTH_PASSWORD=CHANGE_ME
JIBRI_XMPP_PASSWORD=CHANGE_ME
JIBRI_RECORDER_PASSWORD=CHANGE_ME

# Запись (Jibri)
ENABLE_RECORDING=1

# Модерация: владельцем комнаты становится только moderator из JWT
# (token_affiliation), а не первый вошедший. Без этого коллектор получает
# auto-owner и его нативный Jitsi-клиент убивает комнату (conference.destroyed).
ENABLE_AUTO_OWNER=false
ENABLE_VISITORS=0
